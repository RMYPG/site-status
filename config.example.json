  "sites": [
    {
      "id": "edity-sandbox",
      "environments": {
        "production": {
          "namespace": "edity-sandbox",
          "deployment": "edity-sandbox-sws",
          "helmRelease": "edity-sandbox",
          "imagePolicy": "edity-sandbox-production",
          "imageRepository": "edity-sandbox",
          "kustomization": "edity-sandbox"
        }
      }
    },
    {
      "id": "fisioindoor",
      "environments": {
        "production": {
          "namespace": "fisioindoor",
